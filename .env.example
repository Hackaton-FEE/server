# Exportar en la terminal; no se carga .env automáticamente.
FEE_ENVIRONMENT=development
# Local: aplicar uv run --frozen alembic upgrade head antes de usar auth.
FEE_DATABASE_URL=sqlite:///./fee.db
# Producción: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Generar una clave estable: python3.12 -c 'import secrets; print(secrets.token_urlsafe(48))'
# FEE_AUTH_SECRET_KEY=<clave aleatoria de al menos 32 bytes>
# Sin clave, development/test generan una efímera por factory (no apta para varios workers).
FEE_AUTH_ISSUER=fee-server
FEE_AUTH_AUDIENCE=fee-app
FEE_ACCESS_TOKEN_TTL_SECONDS=900
FEE_REFRESH_TOKEN_TTL_SECONDS=2592000
FEE_AUTH_LOGIN_MAX_ATTEMPTS=5
FEE_AUTH_LOGIN_LOCK_SECONDS=300
# Límite por IP y ruta pública auth, compartido mediante SQL.
FEE_AUTH_REQUEST_LIMIT=30
FEE_AUTH_REQUEST_WINDOW_SECONDS=60
FEE_MAX_REQUEST_BODY_BYTES=16384
# CORS para Flutter web: JSON de orígenes exactos; móvil nativo no necesita CORS.
FEE_CORS_ORIGINS=[]
