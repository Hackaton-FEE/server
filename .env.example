# Exportar estas variables en la terminal; el servidor no carga archivos .env
# automáticamente. Para cargarlas desde este archivo usa `uv run --env-file .env ...`
# (valores JSON con comillas dobles van entre comillas simples, o `uv` las desnuda).

# --- General ---
# Valores: development, test, production. En production no se publican docs/OpenAPI.
FEE_ENVIRONMENT=development

# --- Base de datos (SQLAlchemy URL) ---
# Local: SQLite. Producción: postgresql+psycopg://usuario:clave@host:5432/fee
FEE_DATABASE_URL=sqlite:///./dev.db

# --- Sesión ---
# Requerido en development y production. Mínimo 32 caracteres. Rotarlo invalida las sesiones activas.
FEE_JWT_SECRET=dev-insecure-secret-change-me-000000000000
# FEE_ACCESS_TOKEN_TTL_SECONDS=3600
# FEE_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- WebAuthn / passkeys ---
FEE_WEBAUTHN_RP_ID=localhost
FEE_WEBAUTHN_RP_NAME=FEE
# Allowlist EXACTA de orígenes. Formato JSON.
#   iOS:     "https://<rp_id>"
#   Android: "android:apk-key-hash:<base64url-sha256-del-certificado-de-firma>"
FEE_WEBAUTHN_ORIGINS='["http://localhost"]'
# FEE_CHALLENGE_TTL_SECONDS=120

# --- Archivos de asociación de dominio (los aporta el equipo Flutter) ---
FEE_ANDROID_PACKAGE_NAME=
FEE_ANDROID_SHA256_FINGERPRINTS=[]
FEE_IOS_APP_IDS=[]

# --- Transporte ---
# Solo para depuración web; formato JSON. Móvil nativo no usa CORS.
FEE_CORS_ORIGINS=[]
# FEE_MAX_REQUEST_BODY_BYTES=16384
# Límite por IP (slowapi). Desactivado por defecto para desarrollo/demo local;
# OBLIGATORIO en producción (la app no arranca sin esto en FEE_ENVIRONMENT=production).
FEE_RATE_LIMIT_ENABLED=0

# --- Motor OSINT (huella digital) ---
# fake: motores simulados deterministas, sin red (única opción por ahora).
# real: subprocesos a las herramientas vendorizadas (fase posterior).
FEE_OSINT_ENGINE_MODE=fake
# FEE_OSINT_RETENTION_DAYS=7
# FEE_OSINT_MAX_CONCURRENT_SCANS=2
# FEE_OSINT_ENGINE_TIMEOUT_SECONDS=120
# FEE_OSINT_MAX_OUTPUT_BYTES=5000000
# Proxy HTTP para las herramientas.
# FEE_OSINT_RESIDENTIAL_PROXY_URL: exclusivo para Holehe e Ignorant (account-recovery / anti-bot).
# FEE_OSINT_NORMAL_PROXY_URL: opcional para Blackbird y Maigret (si está vacío, usan salida directa).
# FEE_OSINT_PROXY_URL: fallback heredado; si no se define el residencial, usa este valor.
FEE_OSINT_PROXY_URL=
FEE_OSINT_RESIDENTIAL_PROXY_URL=
FEE_OSINT_NORMAL_PROXY_URL=
# Raíz de las herramientas vendorizadas (las prepara vendor/osint/setup.sh).
# FEE_OSINT_VENDOR_DIR=vendor/osint
# Segunda pasada acotada sobre alias descubiertos: 0 desactiva; máximo 10.
# FEE_OSINT_MAX_PIVOT_CANDIDATES=3

# --- Verificación de correo (consentimiento para escanear a un tercero) ---
# Estático para el hackathon: el backend acepta siempre este código. Vaciarlo
# desactiva la verificación (ningún código será válido) hasta activar el envío
# real. Ver docs/osint-architecture.md ADR-OSINT-05.
# OBLIGATORIO vacío en producción (la app no arranca en FEE_ENVIRONMENT=production
# si esto tiene cualquier valor): un código estático conocido anula el consentimiento.
FEE_VERIFICATION_STATIC_CODE=1234
# FEE_VERIFICATION_CODE_TTL_SECONDS=600
# FEE_OSINT_CONSENT_TTL_SECONDS=3600

# --- Asistente de higiene de privacidad (LLM) ---
# fake: respuesta determinista, sin red (por defecto y forzado en test).
# real: llama a un proveedor compatible con la API de OpenAI (NVIDIA por defecto).
# disabled: responde 503. Es el valor por defecto del compose de producción.
# fake también responde 503 en producción; nunca se sirve consejo simulado allí.
FEE_ASSISTANT_MODE=fake
# Requerida solo si FEE_ASSISTANT_MODE=real. NUNCA la pegues en el chat ni la
# commitees: solo en este archivo local (ya está en .gitignore) o en el
# secret manager del despliegue.
FEE_ASSISTANT_API_KEY=
# FEE_ASSISTANT_BASE_URL=https://integrate.api.nvidia.com/v1
# FEE_ASSISTANT_MODEL=meta/muse-glimmer-30b
# FEE_ASSISTANT_MAX_MESSAGES=20
# FEE_ASSISTANT_MAX_MESSAGE_CHARS=4000
# FEE_ASSISTANT_MAX_OUTPUT_TOKENS=1024
# FEE_ASSISTANT_TIMEOUT_SECONDS=30
