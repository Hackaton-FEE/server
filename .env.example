# Exportar estas variables en la terminal; el servidor no carga archivos .env automáticamente.

# --- General ---
# Valores: development, test, production. En production no se publican docs/OpenAPI.
FEE_ENVIRONMENT=development

# --- Base de datos (SQLAlchemy URL) ---
# Local: SQLite. Producción: postgresql+psycopg://usuario:clave@host:5432/fee
FEE_DATABASE_URL=sqlite:///./dev.db

# --- Sesión ---
# Requerido en development y production. Mínimo 32 caracteres. Rotarlo invalida las sesiones activas.
FEE_JWT_SECRET=dev-insecure-secret-change-me-000000000000
# FEE_ACCESS_TOKEN_TTL_SECONDS=3600
# FEE_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- WebAuthn / passkeys ---
FEE_WEBAUTHN_RP_ID=localhost
FEE_WEBAUTHN_RP_NAME=FEE
# Allowlist EXACTA de orígenes. Formato JSON.
#   iOS:     "https://<rp_id>"
#   Android: "android:apk-key-hash:<base64url-sha256-del-certificado-de-firma>"
FEE_WEBAUTHN_ORIGINS=["http://localhost"]
# FEE_CHALLENGE_TTL_SECONDS=120

# --- Archivos de asociación de dominio (los aporta el equipo Flutter) ---
FEE_ANDROID_PACKAGE_NAME=
FEE_ANDROID_SHA256_FINGERPRINTS=[]
FEE_IOS_APP_IDS=[]

# --- Transporte ---
# Solo para depuración web; formato JSON. Móvil nativo no usa CORS.
FEE_CORS_ORIGINS=[]
# FEE_MAX_REQUEST_BODY_BYTES=16384

# --- Motor OSINT (huella digital) ---
# fake: motores simulados deterministas, sin red (única opción por ahora).
# real: subprocesos a las herramientas vendorizadas (fase posterior).
FEE_OSINT_ENGINE_MODE=fake
# FEE_OSINT_RETENTION_DAYS=7
# FEE_OSINT_MAX_CONCURRENT_SCANS=2
# FEE_OSINT_ENGINE_TIMEOUT_SECONDS=120
# FEE_OSINT_MAX_OUTPUT_BYTES=5000000
# Proxy HTTP/SOCKS para las herramientas (recomendado para el vector email).
FEE_OSINT_PROXY_URL=
# Raíz de las herramientas vendorizadas (las prepara vendor/osint/setup.sh).
# FEE_OSINT_VENDOR_DIR=vendor/osint
